---
import '../styles/global.css';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import jakartaUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import { site } from '../data/site';
import { whatsappUrl } from '../lib/links';

interface Props {
  title?: string;
  description?: string;
  /** Halaman 404 tidak perlu diindeks */
  noindex?: boolean;
}

const { title = site.seo.title, description = site.seo.description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.jpg', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${new URL('/', Astro.site).href}#bisnis`,
  name: site.name,
  description: site.seo.description,
  url: new URL('/', Astro.site).href,
  image: ogImage,
  telephone: `+${site.whatsapp.number}`,
  servesCuisine: 'Indonesian',
  priceRange: site.priceRange,
  acceptsReservations: false,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', ...site.address.geo },
  hasMap: site.address.mapsUrl,
  openingHoursSpecification: site.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  sameAs: site.socials.map((s) => s.url),
  potentialAction: { '@type': 'OrderAction', target: whatsappUrl() },
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#c0392b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakartaUrl} as="font" type="font/woff2" crossorigin />
    <slot name="head" />

    <!-- Open Graph & Twitter: tampilan saat link dibagikan di WhatsApp, IG, Facebook, X -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} – ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#konten"
      class="sr-only z-[60] rounded-full bg-ink px-5 py-3 font-semibold text-cream focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Langsung ke konten
    </a>
    <slot />
  </body>
</html>
