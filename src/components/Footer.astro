---
import Icon from './Icon.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
const socialLabel = { instagram: 'Instagram', tiktok: 'TikTok' } as const;
---

<footer class="bg-ink pt-14 pb-28 text-cream md:pb-14">
  <div class="container-page flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-display text-2xl font-semibold">{site.name}</p>
      <p class="mt-1 text-cream/75">{site.tagline}</p>
    </div>

    <ul class="flex gap-3">
      {
        site.socials.map((s) => (
          <li>
            <a
              href={s.url}
              target="_blank"
              rel="noopener"
              aria-label={`${socialLabel[s.platform]} ${site.name}`}
              class="grid size-12 place-items-center rounded-full bg-cream/10 hover:bg-gold hover:text-ink"
            >
              <Icon name={s.platform} size={20} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container-page mt-10 flex flex-col gap-2 border-t border-cream/15 pt-6 text-sm text-cream/70 sm:flex-row sm:justify-between">
    <p>&copy; <span data-year>{year}</span> {site.name}. Semua hak dilindungi.</p>
    <p>Dibuat di Bali <span aria-hidden="true">🌴</span></p>
  </div>
</footer>

<script is:inline>
  document.querySelectorAll('[data-year]').forEach((el) => (el.textContent = String(new Date().getFullYear())));
</script>
