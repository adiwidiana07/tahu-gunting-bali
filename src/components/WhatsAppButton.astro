---
import Icon from './Icon.astro';
import { whatsappUrl } from '../lib/links';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener"
  aria-label="Pesan via WhatsApp"
  class="fixed right-4 bottom-4 z-40 grid size-14 place-items-center rounded-full bg-leaf text-white shadow-xl shadow-ink/30 ring-4 ring-cream/80 transition-transform duration-200 hover:scale-105 hover:bg-leaf-dark md:right-6 md:bottom-6 md:size-16"
>
  <Icon name="whatsapp" size={30} />
</a>
