---
import Icon from './Icon.astro';
import Ornament from './Ornament.astro';
import { site } from '../data/site';
import { formatPhone, formatTime, fullAddress, mapsEmbedUrl, whatsappUrl } from '../lib/links';

const socialLabel = { instagram: 'Instagram', tiktok: 'TikTok' } as const;
---

<section id="contact" aria-labelledby="contact-title" class="py-20 md:py-28">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <Ornament />
      <p class="eyebrow mt-4 text-chili">Kontak &amp; lokasi</p>
      <h2 id="contact-title" class="section-title">Mampir atau pesan antar</h2>
      <p class="mt-4 text-lg text-ink-soft">Pesan lewat WhatsApp, ambil sendiri di warung, atau pesan lewat aplikasi ojek online.</p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-5">
      <div class="reveal rounded-[2rem] bg-white p-6 shadow-lg ring-1 shadow-ink/5 ring-ink/5 md:p-10 lg:col-span-2">
        <dl class="grid gap-7">
          <div class="flex gap-4">
            <dt class="grid size-11 shrink-0 place-items-center rounded-xl bg-gold/20 text-leaf">
              <Icon name="map-pin" size={22} /><span class="sr-only">Alamat</span>
            </dt>
            <dd>
              <address class="not-italic">{fullAddress()}</address>
              <a href={site.address.mapsUrl} target="_blank" rel="noopener" class="mt-1 inline-flex items-center gap-1 py-1 font-semibold text-leaf underline decoration-2 underline-offset-4 hover:text-leaf-dark">
                Petunjuk arah <Icon name="arrow-right" size={16} />
              </a>
            </dd>
          </div>

          <div class="flex gap-4">
            <dt class="grid size-11 shrink-0 place-items-center rounded-xl bg-gold/20 text-leaf">
              <Icon name="clock" size={22} /><span class="sr-only">Jam buka</span>
            </dt>
            <dd class="grid gap-3">
              {
                site.hours.map((h) => (
                  <p>
                    <span class="block font-semibold">{h.label}</span>
                    <span class="text-ink-soft">{formatTime(h.opens)}–{formatTime(h.closes)} WITA</span>
                  </p>
                ))
              }
            </dd>
          </div>

          <div class="flex gap-4">
            <dt class="grid size-11 shrink-0 place-items-center rounded-xl bg-gold/20 text-leaf">
              <Icon name="phone" size={22} /><span class="sr-only">WhatsApp</span>
            </dt>
            <dd>
              <a href={whatsappUrl()} target="_blank" rel="noopener" class="font-semibold underline decoration-gold decoration-2 underline-offset-4 hover:text-leaf">
                {formatPhone()}
              </a>
              <p class="text-sm text-ink-soft">WhatsApp, chat saja</p>
            </dd>
          </div>
        </dl>

        <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn-primary mt-8 w-full">
          <Icon name="whatsapp" size={22} /> Pesan via WhatsApp
        </a>

        {
          site.delivery.length > 0 && (
            <div class="mt-8 border-t border-ink/10 pt-6">
              <p class="flex items-center gap-2 font-semibold">
                <Icon name="bike" size={20} class="text-leaf" /> Pesan antar
              </p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {site.delivery.map((d) => (
                  <li>
                    <a href={d.url} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center rounded-full border-2 border-leaf/25 px-4 text-sm font-semibold text-leaf hover:border-leaf hover:bg-leaf hover:text-white">
                      {d.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          site.socials.length > 0 && (
            <div class="mt-6">
              <p class="font-semibold">Ikuti kami</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {site.socials.map((s) => (
                  <li>
                    <a href={s.url} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 rounded-full bg-sand px-4 text-sm font-semibold hover:bg-gold/30">
                      <Icon name={s.platform} size={18} />
                      <span class="sr-only">{socialLabel[s.platform]}:</span> {s.handle}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <!--
        Peta Google dimuat hanya setelah tombol diklik (lebih ringan dan tanpa cookie pihak ketiga
        saat halaman dibuka). Tanpa JavaScript, kartu ini tetap menjadi link ke Google Maps.
      -->
      <div class="reveal relative min-h-80 overflow-hidden rounded-[2rem] bg-[#e9e2d0] shadow-lg ring-1 shadow-ink/5 ring-ink/5 lg:col-span-3" data-map data-embed={mapsEmbedUrl()}>
        <svg class="absolute inset-0 size-full" aria-hidden="true" preserveAspectRatio="xMidYMid slice" viewBox="0 0 600 400">
          <rect width="600" height="400" fill="#ece5d3" />
          <path d="M0 250 C 150 230, 260 300, 600 260" stroke="#b7d3a8" stroke-width="40" fill="none" opacity=".7" />
          <g stroke="#fffaf0" stroke-linecap="round" fill="none">
            <path d="M-20 120 L620 170" stroke-width="18" />
            <path d="M180 -20 L240 420" stroke-width="14" />
            <path d="M420 -20 L380 420" stroke-width="10" />
            <path d="M-20 330 L620 300" stroke-width="10" />
            <path d="M0 40 L600 70" stroke-width="6" />
            <path d="M80 -20 L60 420" stroke-width="6" />
            <path d="M520 -20 L540 420" stroke-width="6" />
          </g>
        </svg>
        <div class="relative grid h-full min-h-80 place-content-center justify-items-center gap-5 p-6 text-center">
          <span class="grid size-16 place-items-center rounded-full bg-chili text-white shadow-xl shadow-chili/30">
            <Icon name="map-pin" size={30} />
          </span>
          <p class="max-w-xs rounded-2xl bg-cream/95 px-4 py-2 text-sm font-semibold shadow">{site.name}<br /><span class="font-normal text-ink-soft">{site.address.city}, {site.address.region}</span></p>
          <div class="flex flex-wrap justify-center gap-3">
            <button type="button" class="btn-leaf hidden" data-map-load>
              <Icon name="map" size={20} /> Tampilkan peta
            </button>
            <a href={site.address.mapsUrl} target="_blank" rel="noopener" class="btn bg-cream text-ink shadow hover:bg-white">
              Buka di Google Maps <Icon name="arrow-right" size={18} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
