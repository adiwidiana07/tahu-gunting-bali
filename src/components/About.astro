---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Ornament from './Ornament.astro';
import { site } from '../data/site';
import { formatRupiah } from '../lib/links';

const { about, startingPrice } = site;
---

<section id="about" aria-labelledby="about-title" class="py-20 md:py-28">
  <div class="container-page grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <div class="reveal relative mx-auto w-full max-w-md lg:max-w-none">
      <div class="absolute -inset-1 -z-10 translate-x-2 translate-y-2 rounded-[2rem] sm:-inset-3 sm:translate-x-4 sm:translate-y-4 border-2 border-gold/60" aria-hidden="true"></div>
      <Picture
        src={about.image.src}
        alt={about.image.alt}
        formats={['avif', 'webp']}
        widths={[400, 600, 800, 1000]}
        sizes="(min-width: 1152px) 520px, (min-width: 1024px) 45vw, min(100vw - 2rem, 28rem)"
        loading="lazy"
        decoding="async"
        class="aspect-[4/5] w-full rounded-2xl object-cover shadow-xl shadow-ink/15"
        style={about.image.position && `object-position: ${about.image.position}`}
      />
    </div>

    <div class="reveal mx-auto max-w-2xl lg:max-w-none">
      <p class="eyebrow text-chili">Tentang kami</p>
      <h2 id="about-title" class="section-title">{about.title}</h2>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-ink-soft">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <ul class="mt-10 grid gap-5">
        {
          about.highlights.map((h) => (
            <li class="flex gap-4">
              <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-gold/20 text-leaf">
                <Icon name={h.icon} size={24} />
              </span>
              <div>
                <h3 class="font-sans text-lg font-bold text-ink">{h.title}</h3>
                <p class="text-ink-soft">{h.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-page mt-20 md:mt-28">
    <div class="reveal rounded-[2rem] bg-sand px-5 py-10 text-center md:px-12 md:py-14">
      <Ornament />
      <h3 class="mt-4 text-2xl font-semibold text-leaf md:text-3xl">Harga mulai dari</h3>
      <p class="mt-2 font-display text-5xl font-semibold text-chili md:text-6xl">{formatRupiah(startingPrice)}</p>
      <p class="mt-3 text-ink-soft">per porsi</p>
    </div>
  </div>
</section>
