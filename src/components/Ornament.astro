---
/** Pembatas section bermotif patra Bali (sulur melingkar simetris), dekoratif saja. */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

// Separuh motif (kiri); separuh kanan adalah cerminannya.
const half = `
  <path d="M80 16c-6-9-16-9-20-3s1 11 6 9 4-7 0-7"/>
  <path d="M80 16c-6 9-16 9-20 3" opacity=".7"/>
  <path d="M58 16c-8-7-18-6-22 0 4 6 14 7 22 0Z"/>
  <path d="M36 16c-4-4-9-5-13-3m13 3c-4 4-9 5-13 3"/>
  <circle cx="17" cy="16" r="2" fill="currentColor" stroke="none"/>
  <circle cx="8" cy="16" r="1.2" fill="currentColor" stroke="none"/>`;
---

<div class:list={['flex items-center justify-center gap-3 text-gold', className]} aria-hidden="true">
  <span class="h-px w-10 bg-current opacity-60 md:w-24"></span>
  <svg viewBox="0 0 160 32" width="160" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <g set:html={half} />
    <g transform="matrix(-1 0 0 1 160 0)" set:html={half} />
    <path d="M80 6l6 10-6 10-6-10Z" fill="currentColor" fill-opacity=".25" />
  </svg>
  <span class="h-px w-10 bg-current opacity-60 md:w-24"></span>
</div>
