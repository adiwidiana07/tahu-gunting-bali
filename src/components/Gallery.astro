---
import { Picture, getImage } from 'astro:assets';
import Ornament from './Ornament.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

// Versi besar untuk lightbox (dimuat hanya saat foto dibuka).
const photos = await Promise.all(
  site.gallery.map(async (photo) => {
    const large = await getImage({ src: photo.src, widths: [800, 1200, 1600], format: 'webp' });
    return { ...photo, large: { src: large.src, srcset: large.srcSet.attribute } };
  }),
);
---

<section id="gallery" aria-labelledby="gallery-title" class="bg-sand py-20 md:py-28">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <Ornament />
      <p class="eyebrow mt-4 text-chili">Galeri</p>
      <h2 id="gallery-title" class="section-title">Hangat, renyah, dan bikin nagih</h2>
      <p class="mt-4 text-lg text-ink-soft">Ketuk foto untuk melihat lebih besar.</p>
    </div>

    <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5" data-gallery>
      {
        photos.map((photo, i) => (
          <li class="reveal">
            <a
              href={photo.large.src}
              data-index={i}
              data-src={photo.large.src}
              data-srcset={photo.large.srcset}
              data-alt={photo.alt}
              class="group relative block overflow-hidden rounded-2xl bg-ink/10 shadow-md shadow-ink/10"
              aria-label={`Perbesar foto ${i + 1} dari ${photos.length}: ${photo.alt}`}
            >
              <Picture
                src={photo.src}
                alt={photo.alt}
                formats={['avif', 'webp']}
                widths={[240, 360, 480, 720]}
                sizes="(min-width: 1152px) 352px, (min-width: 768px) 31vw, 47vw"
                loading="lazy"
                decoding="async"
                class="aspect-[4/5] w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <span class="absolute right-2.5 bottom-2.5 grid size-9 place-items-center rounded-full bg-cream/90 text-ink opacity-0 shadow transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true">
                <Icon name="arrow-right" size={18} class="-rotate-45" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <dialog
    data-lightbox
    aria-label="Galeri foto"
    class="m-0 h-dvh max-h-none w-screen max-w-none overflow-hidden bg-[#1c1410] p-0 text-cream backdrop:bg-black/60 open:grid"
  >
    <div data-lb-stage class="grid size-full grid-rows-[auto_1fr_auto] gap-3 p-3 md:p-6">
      <div class="flex items-center justify-between">
        <p data-lb-count class="rounded-full bg-ink/60 px-3 py-1 text-sm font-semibold" aria-live="polite"></p>
        <button type="button" data-lb="close" class="grid size-12 place-items-center rounded-full bg-cream/10 hover:bg-cream/20" aria-label="Tutup galeri">
          <Icon name="x" size={26} />
        </button>
      </div>

      <figure data-lb-stage class="relative m-0 min-h-0">
        <img
          data-lb-img
          alt=""
          sizes="(min-width: 1024px) 70vw, 100vw"
          class="absolute inset-0 m-auto max-h-full max-w-full touch-pan-y rounded-2xl object-contain shadow-2xl select-none"
          draggable="false"
        />
      </figure>

      <div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4 pb-2">
        <button type="button" data-lb="prev" class="grid size-12 shrink-0 place-items-center rounded-full bg-cream text-ink hover:bg-gold" aria-label="Foto sebelumnya">
          <Icon name="chevron-left" size={26} />
        </button>
        <p data-lb-caption class="text-center text-sm text-cream/90 md:text-base"></p>
        <button type="button" data-lb="next" class="grid size-12 shrink-0 place-items-center rounded-full bg-cream text-ink hover:bg-gold" aria-label="Foto berikutnya">
          <Icon name="chevron-right" size={26} />
        </button>
      </div>
    </div>
  </dialog>
</section>

<script>
  import '../scripts/lightbox';
</script>
