---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title={`Halaman tidak ditemukan – ${site.name}`} noindex>
  <main id="konten" class="container-page grid min-h-svh place-content-center py-16 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="section-title">Waduh, halaman ini sudah habis terjual</h1>
    <p class="mx-auto mt-4 max-w-md text-ink-soft">Halaman yang Anda cari tidak ada. Tipat tahunya masih ada, kok.</p>
    <a href="/" class="btn-primary mx-auto mt-8">Kembali ke beranda</a>
  </main>
</BaseLayout>
